# Copy this file to .env and adjust credentials for PostgreSQL on Docker Desktop
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/ticketrush
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Google OAuth2 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH2_REDIRECT_URI=http://localhost:5173/auth

# SMTP credentials (use Gmail App Password generated from the SAME account below)
SPRING_MAIL_USERNAME=dangkhuat50@gmail.com
SPRING_MAIL_PASSWORD=

# MinIO
APP_MINIO_ENABLED=false
APP_MINIO_ENDPOINT=http://localhost:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_BUCKET=ticketrush-images
APP_MINIO_PUBLIC_BASE_URL=http://localhost:9000
