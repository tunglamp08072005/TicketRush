# Copy this file to .env and adjust credentials for PostgreSQL on Docker Desktop
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/ticketrush
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Google OAuth2 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH2_REDIRECT_URI=http://localhost:5173/auth
